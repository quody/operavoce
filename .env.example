# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Note: The following secrets are configured via Supabase Edge Function secrets
# (not in this file). See README.md for setup instructions.
#
#   SUPABASE_SERVICE_ROLE_KEY  — auto-injected by Supabase into Edge Functions
#   APPLE_SHARED_SECRET        — set via: npx supabase secrets set APPLE_SHARED_SECRET=...
